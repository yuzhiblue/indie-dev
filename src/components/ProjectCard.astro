---
import type { CollectionEntry } from 'astro:content';

interface Props {
	project: CollectionEntry<'projects'>;
	layout?: 'list' | 'grid';
}

const { project, layout = 'list' } = Astro.props;
const hasCover = Boolean(project.data.coverImage);
const initial = (project.data.title || '?').trim().charAt(0);
---

<a
	href={`/projects/${project.id}`}
	class:list={['project-card', `is-${layout}`, { 'no-cover': !hasCover }]}
>
	{hasCover ? (
		<img
			src={project.data.coverImage}
			alt={`${project.data.title} 封面`}
			class="project-thumb"
			loading="lazy"
			decoding="async"
		/>
	) : (
		<div
			class="project-thumb project-thumb-placeholder"
			role="img"
			aria-label={`${project.data.title} 封面占位`}
		>
			<span class="project-thumb-initial">{initial}</span>
		</div>
	)}
	<div class="project-card-body">
		<h2>
			{project.data.title}
			{project.data.featured && <span class="featured-badge">Featured</span>}
		</h2>
		<p>{project.data.description}</p>
		<div class="project-meta">
			{project.data.pubDate && (
				<span class="project-date">
					{project.data.pubDate.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' })}
				</span>
			)}
			{project.data.tags.length > 0 && (
				<div class="project-tags">
					{project.data.tags.map((tag) => (<span class="project-tag">{tag}</span>))}
				</div>
			)}
		</div>
	</div>
</a>

<style>
	.project-card {
		display: flex;
		gap: 20px;
		align-items: stretch;
		padding: 20px;
		background: var(--card-bg);
		border: 1px solid var(--border);
		border-radius: 12px;
		text-decoration: none;
		transition: border-color 0.2s, transform 0.2s;
	}
	.project-card:hover {
		border-color: var(--accent);
		transform: translateY(-2px);
	}
	.project-card-body {
		flex: 1;
		min-width: 0;
		display: flex;
		flex-direction: column;
	}
	.project-card h2 {
		font-size: 1.15rem;
		font-weight: 600;
		margin-bottom: 8px;
		color: var(--text);
		display: flex;
		align-items: center;
		gap: 8px;
		flex-wrap: wrap;
	}
	.project-card:hover h2 { color: var(--accent); }
	.project-card p {
		color: var(--text-muted);
		font-size: 0.9rem;
		margin-bottom: 12px;
	}
	.project-thumb {
		flex-shrink: 0;
		border-radius: 10px;
		border: 1px solid var(--border);
		background: var(--bg-secondary);
		object-fit: cover;
		display: block;
	}
	.project-thumb-placeholder {
		display: flex;
		align-items: center;
		justify-content: center;
		background: linear-gradient(135deg, #1e1e2e 0%, #2a2a3e 100%);
		color: var(--text-muted);
		font-size: 1.8rem;
		font-weight: 700;
		letter-spacing: -0.02em;
	}
	.project-thumb-initial { user-select: none; }
	.project-meta {
		display: flex;
		align-items: center;
		gap: 12px;
		font-size: 0.8rem;
		color: var(--text-muted);
		margin-top: auto;
		flex-wrap: wrap;
	}
	.project-date { white-space: nowrap; }
	.project-tags {
		display: flex;
		gap: 6px;
		margin-left: auto;
		flex-wrap: wrap;
		justify-content: flex-end;
	}
	.project-tag {
		background: var(--bg-secondary);
		padding: 2px 8px;
		border-radius: 12px;
		border: 1px solid var(--border);
	}
	.featured-badge {
		display: inline-block;
		background: var(--accent);
		color: #fff;
		font-size: 0.7rem;
		padding: 2px 8px;
		border-radius: 20px;
		font-weight: 600;
	}

	/* 列表模式：横向 + 200x130 缩略图（用于 /projects 列表） */
	.project-card.is-list { margin-bottom: 16px; }
	.project-card.is-list .project-thumb { width: 200px; height: 130px; }

	/* 网格模式：纵向 + 16:9 顶部封面（用于首页 Projects） */
	.project-card.is-grid {
		flex-direction: column;
		padding: 0;
		overflow: hidden;
	}
	.project-card.is-grid .project-thumb {
		width: 100%;
		height: auto;
		aspect-ratio: 16 / 9;
		border: none;
		border-radius: 0;
	}
	.project-card.is-grid .project-thumb-placeholder { border-radius: 0; }
	.project-card.is-grid .project-card-body { padding: 20px; }
	.project-card.is-grid h2 { font-size: 1.1rem; }
	.project-card.is-grid p { margin-bottom: 16px; line-height: 1.5; }
	.project-card.is-grid .project-tags { margin-left: 0; justify-content: flex-start; }

	@media (max-width: 640px) {
		.project-card.is-list { flex-direction: column; }
		.project-card.is-list .project-thumb { width: 100%; height: 180px; }
	}
</style>
