---
import type { CollectionEntry } from 'astro:content';

interface Props {
	post: CollectionEntry<'blog'>;
	compact?: boolean;
}

const { post, compact = false } = Astro.props;

const readingTime = (body: string) => {
	const cjk = (body.match(/[一-龥]/g) || []).length;
	const words = (body.replace(/[一-龥]/g, ' ').match(/\b\w+\b/g) || []).length;
	return Math.max(1, Math.round(cjk / 400 + words / 200));
};
---

<article class:list={['post-card', { compact }]}>
	<a href={`/blog/${post.id}`} class="post-card-main">
		<h2>{post.data.title}</h2>
		{!compact && <p>{post.data.description}</p>}
		<div class="post-meta">
			<span>
				{post.data.pubDate.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' })}
			</span>
			<span class="dot">·</span>
			<span>{readingTime(post.body ?? '')} 分钟阅读</span>
		</div>
	</a>
	{post.data.tags.length > 0 && (
		<div class="post-tags">
			{post.data.tags.map((tag) => (
				<a class="post-tag" href={`/blog/tag/${encodeURIComponent(tag)}`}>{tag}</a>
			))}
		</div>
	)}
	<a href={`/blog/${post.id}`} class="post-card-overlay" aria-label={post.data.title}></a>
</article>

<style>
	.post-card {
		position: relative;
		display: block;
		padding: 24px;
		background: var(--card-bg);
		border: 1px solid var(--border);
		border-radius: 12px;
		margin-bottom: 16px;
		transition: border-color 0.2s, transform 0.2s;
		padding-right: 56px;
	}
	.post-card:hover {
		border-color: var(--accent);
		transform: translateY(-2px);
	}
	.post-card-main {
		display: block;
		text-decoration: none;
		position: relative;
		z-index: 1;
	}
	.post-card h2 {
		font-size: 1.15rem;
		font-weight: 600;
		margin-bottom: 8px;
		color: var(--text);
	}
	.post-card p {
		color: var(--text-muted);
		font-size: 0.9rem;
		margin-bottom: 12px;
	}
	.post-meta {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 8px 12px;
		font-size: 0.8rem;
		color: var(--text-muted);
	}
	.post-meta .dot {
		opacity: 0.5;
	}
	.post-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 6px;
		margin-top: 12px;
		position: relative;
		z-index: 1;
	}
	.post-tag {
		background: var(--bg-secondary);
		padding: 2px 8px;
		border-radius: 12px;
		border: 1px solid var(--border);
		color: var(--text-muted);
		font-size: 0.75rem;
		text-decoration: none;
		transition: border-color 0.2s, color 0.2s;
	}
	.post-tag:hover {
		border-color: var(--accent);
		color: var(--accent);
	}
	.post-card-overlay {
		position: absolute;
		inset: 0;
		z-index: 0;
	}
	.post-card::after {
		content: '→';
		color: var(--text-muted);
		font-size: 1.1rem;
		position: absolute;
		top: 24px;
		right: 24px;
		z-index: 1;
		transition: color 0.2s, transform 0.2s;
		pointer-events: none;
	}
	.post-card:hover::after {
		color: var(--accent);
		transform: translateX(4px);
	}

	/* 紧凑模式：用于相关推荐等网格场景 */
	.post-card.compact {
		padding: 16px 18px;
		padding-right: 18px;
		margin-bottom: 0;
		height: 100%;
	}
	.post-card.compact h2 {
		font-size: 0.95rem;
		line-height: 1.4;
		margin-bottom: 12px;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
		transition: color 0.2s;
	}
	.post-card.compact:hover h2 {
		color: var(--accent);
	}
	.post-card.compact .post-meta {
		font-size: 0.75rem;
		gap: 6px 8px;
	}
	.post-card.compact::after {
		content: none;
	}
	.post-card.compact .post-card-overlay {
		content: none;
	}
</style>
