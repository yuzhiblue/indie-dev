---
import type { JsonLd } from '../lib/seo';

interface Props {
  title: string;
  description: string;
  lang?: string;
  /** title 已是完整标题时置为 true，不再追加站点名后缀 */
  rawTitle?: boolean;
  /** Open Graph 类型 */
  type?: 'website' | 'article' | 'profile';
  /** 分享图：public 下的绝对路径，或完整 URL */
  image?: string;
  /** 输出 noindex（如 404、低价值归档页） */
  noindex?: boolean;
  /** 结构化数据（JSON-LD），单个对象或数组 */
  schema?: JsonLd | JsonLd[];
  /** 宽幅布局（1180px 容器 + 无顶部留白），用于首页 */
  wide?: boolean;
}

const {
  title,
  description,
  lang = 'zh-CN',
  rawTitle = false,
  type = 'website',
  image,
  noindex = false,
  schema,
  wide = false,
} = Astro.props;

const site = Astro.site ?? new URL('https://7tec.cn');
const canonical = new URL(Astro.url.pathname, site).toString();
const fullTitle = rawTitle ? title : `${title} | 7TEC`;
// 页面没有专属封面时回落到站点默认分享图，保证任何页面都有 og:image
const ogImage = new URL(image ?? '/og-default.png', site).toString();
const ogLocaleMap: Record<string, string> = { en: 'en_US', ja: 'ja_JP' };
const ogLocale = ogLocaleMap[lang] ?? 'zh_CN';
const schemaList = schema ? (Array.isArray(schema) ? schema : [schema]) : [];
// 避免 JSON 内容中的 </script> 提前闭合标签
const toJsonLd = (value: JsonLd) => JSON.stringify(value).replace(/</g, '\\u003c');

const socialLinks = [
  {
    label: 'GitHub',
    href: 'https://github.com/yuzhiblue',
    note: '@yuzhiblue',
    icon: '<svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><path d="M12 .5C5.7.5.5 5.7.5 12c0 5.1 3.3 9.4 7.9 10.9.6.1.8-.3.8-.6v-2c-3.2.7-3.9-1.5-3.9-1.5-.5-1.3-1.3-1.7-1.3-1.7-1.1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 .1.8 1.7 2.6 1.2.1-.7.4-1.2.7-1.5-2.6-.3-5.3-1.3-5.3-5.7 0-1.3.5-2.3 1.2-3.1-.1-.3-.5-1.5.1-3.1 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0C17.3 4.6 18.3 5 18.3 5c.6 1.6.2 2.8.1 3.1.8.8 1.2 1.8 1.2 3.1 0 4.4-2.7 5.4-5.3 5.7.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6 4.6-1.5 7.9-5.8 7.9-10.9C23.5 5.7 18.3.5 12 .5z"/></svg>',
  },
  {
    label: 'X',
    href: 'https://x.com/yuzhiblue',
    note: '@yuzhiblue',
    icon: '<svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M18.2 2H21l-6.6 7.6L22 22h-6.2l-4.9-6.4L5.2 22H2.4l7-8.1L2 2h6.4l4.4 5.9L18.2 2zm-1.1 18h1.7L7 3.9H5.2L17.1 20z"/></svg>',
  },
  {
    label: 'RSS',
    href: '/rss.xml',
    note: '订阅更新',
    icon: '<svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><path d="M19.199 24C19.199 13.467 10.533 4.8 0 4.8V0c13.165 0 24 10.835 24 24h-4.801zM3.291 17.415c1.814 0 3.293 1.479 3.293 3.295 0 1.813-1.485 3.29-3.301 3.29C1.47 24 0 22.526 0 20.71s1.475-3.294 3.291-3.295zM15.909 24h-4.665c0-6.169-5.075-11.245-11.244-11.245V8.09c8.727 0 15.909 7.184 15.909 15.91z"/></svg>',
  },
  {
    label: '公众号',
    href: '',
    note: '搜索 7TEC 关注',
    static: true,
    icon: '<svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><path d="M8.7 3C4.5 3 1 5.9 1 9.5c0 2.3 1.3 4.3 3.4 5.6L3.3 18l2.9-1.5c.9.2 1.8.4 2.5.4h.4a6 6 0 0 1-.2-1.6c0-3.6 3.4-6.4 7.6-6.4h.4C16.5 4.9 12.9 3 8.7 3zm-2.6 4.2a1.1 1.1 0 1 1 0 2.2 1.1 1.1 0 0 1 0-2.2zm5.2 0a1.1 1.1 0 1 1 0 2.2 1.1 1.1 0 0 1 0-2.2zM16 9.8c-3.3 0-6 2.4-6 5.4 0 3 2.7 5.4 6 5.4.6 0 1.2-.1 1.8-.3l2.5 1.3-.7-2.3c1.4-1 2.3-2.5 2.3-4.1 0-3-2.7-5.4-6-5.4zm-2 3.7a.9.9 0 1 1 0 1.8.9.9 0 0 1 0-1.8zm4 0a.9.9 0 1 1 0 1.8.9.9 0 0 1 0-1.8z"/></svg>',
  },
];

import '../styles/tokens.css';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <!-- 百度统计 -->
    <script is:inline>
      var _hmt = _hmt || [];
      (function() {
        var hm = document.createElement("script");
        hm.src = "https://hm.baidu.com/hm.js?6061ca7d417fc9c43e2d8b5626b7147d";
        var s = document.getElementsByTagName("script")[0];
        s.parentNode.insertBefore(hm, s);
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#f5f2ea" />
    <meta name="description" content={description} />
    <meta name="google-adsense-account" content="ca-pub-4625795004585815" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <!-- Google AdSense -->
    <script
      is:inline
      async
      src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-4625795004585815"
      crossorigin="anonymous"
    ></script>
    <title>{fullTitle}</title>
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="author" content="yuzhiblue" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="7TEC" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale} />
    {ogImage && <meta property="og:image" content={ogImage} />}

    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}

    <link rel="alternate" type="application/rss+xml" title="7TEC 开发博客" href={new URL('/rss.xml', site).toString()} />

    {schemaList.map((item) => (
      <script type="application/ld+json" is:inline set:html={toJsonLd(item)} />
    ))}

    <slot name="head" />
    <style is:global>
      * { margin: 0; padding: 0; box-sizing: border-box; }
      body {
        font-family: var(--font-sans);
        background: var(--bg); color: var(--text); line-height: 1.6;
        min-height: 100vh; display: flex; flex-direction: column;
      }
      a { color: var(--link); text-decoration: none; }
      a:hover { color: var(--link-hover); }
      .container { max-width: var(--max-width); margin: 0 auto; padding: 0 24px; }
      header { border-bottom: 1px solid var(--border); padding: 20px 0; }
      header .container { display: flex; align-items: center; justify-content: space-between; }
      .logo {
        display: inline-flex; align-items: center; gap: 9px;
        color: var(--text); text-decoration: none;
      }
      .logo-mark {
        display: grid; width: 30px; height: 30px; place-items: center;
        background: var(--accent-strong); color: #fff;
        font-size: 0.92rem; font-weight: 800; line-height: 1;
      }
      .logo-wordmark { font-size: 1.2rem; font-weight: 800; letter-spacing: -0.055em; }
      .logo-caption {
        margin-left: 6px; padding-left: 12px; border-left: 1px solid var(--border);
        color: var(--text-muted); font-size: 0.76rem; letter-spacing: 0.02em;
      }
      nav { display: flex; gap: 24px; }
      nav a { color: var(--text-muted); font-size: 0.9rem; transition: color 0.2s; }
      nav a:hover { color: var(--text); }
      main { padding: 60px 0; flex: 1; }
      body.wide { --max-width: 1180px; }
      body.wide main { padding: 0 0 76px; }
      a:focus-visible {
        outline: 3px solid var(--accent);
        outline-offset: 4px;
      }
      @media (prefers-reduced-motion: reduce) {
        *, *::before, *::after {
          scroll-behavior: auto !important;
          animation-duration: 0.01ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 0.01ms !important;
        }
      }
      footer { border-top: 1px solid var(--border); padding: 30px 0; text-align: center; color: var(--text-muted); font-size: 0.85rem; }
      footer p + p { margin-top: 6px; }
      .footer-links a { color: var(--text-muted); }
      .footer-links a:hover { color: var(--text); }
      .footer-sep { margin: 0 8px; opacity: 0.5; }
      .site-follow {
        padding: 64px 0 56px; flex-shrink: 0;
        text-align: center; background: var(--bg);
      }
      .footer-follow-title { font-size: 1.6rem; font-weight: 700; margin-bottom: 12px; color: var(--text); letter-spacing: -0.02em; }
      .footer-follow-desc { color: var(--text-muted); font-size: 1.05rem; margin-bottom: 32px; }
      .follow-links { display: flex; flex-wrap: wrap; gap: 16px; justify-content: center; }
      .follow-link {
        display: inline-flex; align-items: center; justify-content: center;
        background: transparent; border: 1px solid var(--border);
        color: var(--text); padding: 16px; border-radius: var(--radius);
        transition: border-color 0.2s, transform 0.2s, color 0.2s;
      }
      .follow-link:hover { border-color: var(--accent); transform: translateY(-2px); color: var(--accent); }
      .follow-link--static { cursor: default; gap: 8px; padding: 12px 16px; }
      .follow-link--static:hover { border-color: var(--border); transform: none; color: var(--text); }
      .follow-note { font-size: 0.85rem; color: var(--text-muted); }
      .follow-icon { display: inline-flex; line-height: 0; }
      .follow-icon svg { display: block; width: 24px; height: 24px; }
      /* 响应式三档：1024（小笔记本）/ 768（平板）/ 640（手机） */
      @media (max-width: 1024px) {
        .container { padding: 0 20px; }
      }
      @media (max-width: 768px) {
        header { padding: 16px 0; }
        nav { gap: 18px; }
        main { padding: 48px 0; }
      }
      @media (max-width: 640px) {
        nav { gap: 14px; }
        .logo-caption { display: none; }
      }
    </style>
  </head>
  <body class:list={{ wide }}>
    <header>
      <div class="container">
        <a href="/" class="logo" aria-label="7TEC 首页">
          <span class="logo-mark" aria-hidden="true">7</span>
          <span class="logo-wordmark" aria-hidden="true">7TEC</span>
          <span class="logo-caption">独立开发者工作室</span>
        </a>
        <nav aria-label="主导航">
          <a href="/projects/">项目</a>
          <a href="/blog/">开发笔记</a>
          <a href="/about/">关于</a>
        </nav>
      </div>
    </header>
    <main class:list={{ 'main--home': wide }}><div class="container"><slot /></div></main>
    <section class="site-follow">
      <div class="container">
        <h2 class="footer-follow-title">关注我</h2>
        <p class="footer-follow-desc">在以下平台找到我，获取最新项目与分享</p>
        <div class="follow-links">
          {socialLinks.map((link) => (
            link.static ? (
              <span
                class="follow-link follow-link--static"
                title={link.note}
                aria-label={`${link.label}：${link.note}`}
              >
                <span class="follow-icon" set:html={link.icon} />
                <span class="follow-note">{link.note}</span>
              </span>
            ) : (
              <a
                class="follow-link"
                href={link.href}
                target={link.href.startsWith('http') ? '_blank' : undefined}
                rel="noopener noreferrer"
                aria-label={`${link.label} ${link.note}`}
              >
                <span class="follow-icon" set:html={link.icon} />
              </a>
            )
          ))}
        </div>
      </div>
    </section>
    <footer>
      <div class="container">
        <p>&copy; {new Date().getFullYear()} yuzhiblue · 保留所有权利。</p>
        <p class="footer-links">
          <a href="/privacy/">隐私政策</a>
          <span class="footer-sep" aria-hidden="true">·</span>
          <a href="/about/">关于</a>
        </p>
        <p class="beian"><a href="https://beian.miit.gov.cn" target="_blank" rel="noopener">浙ICP备17049499号-1</a></p>
      </div>
    </footer>
  </body>
</html>
