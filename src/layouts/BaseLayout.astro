const socialLinks = [
  {
    label: 'GitHub',
    href: 'https://github.com/yuzhiblue',
    note: '@yuzhiblue',
    icon: '<svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><path d="M12 .5C5.7.5.5 5.7.5 12c0 5.1 3.3 9.4 7.9 10.9.6.1.8-.3.8-.6v-2c-3.2.7-3.9-1.5-3.9-1.5-.5-1.3-1.3-1.7-1.3-1.7-1.1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 .1.8 1.7 2.6 1.2.1-.7.4-1.2.7-1.5-2.6-.3-5.3-1.3-5.3-5.7 0-1.3.5-2.3 1.2-3.1-.1-.3-.5-1.5.1-3.1 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0C17.3 4.6 18.3 5 18.3 5c.6 1.6.2 2.8.1 3.1.8.8 1.2 1.8 1.2 3.1 0 4.4-2.7 5.4-5.3 5.7.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6 4.6-1.5 7.9-5.8 7.9-10.9C23.5 5.7 18.3.5 12 .5z"/></svg>',
  },
  {
    label: 'X',
    href: 'https://x.com/yuzhiblue',
    note: '@yuzhiblue',
    icon: '<svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M18.2 2H21l-6.6 7.6L22 22h-6.2l-4.9-6.4L5.2 22H2.4l7-8.1L2 2h6.4l4.4 5.9L18.2 2zm-1.1 18h1.7L7 3.9H5.2L17.1 20z"/></svg>',
  },
  {
    label: '公众号',
    href: '#',
    note: '搜索 7TEC 关注',
    icon: '<svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><path d="M8.7 3C4.5 3 1 5.9 1 9.5c0 2.3 1.3 4.3 3.4 5.6L3.3 18l2.9-1.5c.9.2 1.8.4 2.5.4h.4a6 6 0 0 1-.2-1.6c0-3.6 3.4-6.4 7.6-6.4h.4C16.5 4.9 12.9 3 8.7 3zm-2.6 4.2a1.1 1.1 0 1 1 0 2.2 1.1 1.1 0 0 1 0-2.2zm5.2 0a1.1 1.1 0 1 1 0 2.2 1.1 1.1 0 0 1 0-2.2zM16 9.8c-3.3 0-6 2.4-6 5.4 0 3 2.7 5.4 6 5.4.6 0 1.2-.1 1.8-.3l2.5 1.3-.7-2.3c1.4-1 2.3-2.5 2.3-4.1 0-3-2.7-5.4-6-5.4zm-2 3.7a.9.9 0 1 1 0 1.8.9.9 0 0 1 0-1.8zm4 0a.9.9 0 1 1 0 1.8.9.9 0 0 1 0-1.8z"/></svg>',
  },
];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="./favicon.svg" />
    <title>{title}</title>
    <style is:global>
      * { margin: 0; padding: 0; box-sizing: border-box; }
      :root {
        --bg: #0a0a0a; --bg-secondary: #111; --text: #fafafa;
        --text-muted: #888; --accent: #6366f1; --accent-hover: #4f46e5;
        --border: #222; --card-bg: #161616;
      }
      body {
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        background: var(--bg); color: var(--text); line-height: 1.6;
        min-height: 100vh; display: flex; flex-direction: column;
      }
      a { color: var(--accent); text-decoration: none; }
      a:hover { color: var(--accent-hover); }
      .container { max-width: 900px; margin: 0 auto; padding: 0 24px; }
      header { border-bottom: 1px solid var(--border); padding: 20px 0; }
      header .container { display: flex; align-items: center; justify-content: space-between; }
      .logo { font-size: 1.25rem; font-weight: 700; color: var(--text); letter-spacing: -0.02em; }
      nav { display: flex; gap: 24px; }
      nav a { color: var(--text-muted); font-size: 0.9rem; transition: color 0.2s; }
      nav a:hover { color: var(--text); }
      main { padding: 60px 0; flex: 1; }
      footer { border-top: 1px solid var(--border); padding: 40px 0 30px; text-align: center; color: var(--text-muted); font-size: 0.85rem; }
      .footer-follow { margin-bottom: 28px; }
      .footer-follow h2 { font-size: 1.2rem; font-weight: 600; margin-bottom: 8px; color: var(--text); }
      .footer-follow > p { color: var(--text-muted); font-size: 0.9rem; margin-bottom: 20px; }
      .follow-links { display: flex; flex-wrap: wrap; gap: 12px; justify-content: center; }
      .follow-link {
        display: inline-flex; align-items: center; justify-content: center;
        background: transparent; border: 1px solid var(--border);
        color: var(--text); padding: 12px; border-radius: 10px;
        transition: border-color 0.2s, transform 0.2s, color 0.2s;
      }
      .follow-link:hover { border-color: var(--accent); transform: translateY(-2px); color: var(--accent); }
      .follow-icon { display: inline-flex; line-height: 0; }
      .follow-icon svg { display: block; }
      @media (max-width: 640px) { nav { gap: 16px; } }
    </style>
  </head>
  <body>
    <header>
      <div class="container">
        <a href="/" class="logo">yuzhiblue</a>
        <nav>
          <a href="/projects">Projects</a>
          <a href="/blog">Blog</a>
          <a href="/about">About</a>
        </nav>
      </div>
    </header>
    <main><div class="container"><slot /></div></main>
    <footer>
      <div class="container">
        <section class="footer-follow">
          <h2>关注我</h2>
          <p>在以下平台找到我，获取最新项目与分享</p>
          <div class="follow-links">
            {socialLinks.map((link) => (
              <a
                class="follow-link"
                href={link.href}
                target={link.href.startsWith('http') ? '_blank' : undefined}
                rel="noopener noreferrer"
                aria-label={`${link.label} ${link.note}`}
              >
                <span class="follow-icon" set:html={link.icon} />
              </a>
            ))}
          </div>
        </section>
        <p>&copy; {new Date().getFullYear()} yuzhiblue. All rights reserved.</p>
        <p class="beian"><a href="https://beian.miit.gov.cn" target="_blank" rel="noopener">浙ICP备17049499号-1</a></p>
      </div>
    </footer>
  </body>
</html>
