---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import PostCard from '../../../components/PostCard.astro';
import Pagination from '../../../components/Pagination.astro';

export async function getStaticPaths() {
	const PAGE_SIZE = 12;
	const posts = await getCollection('blog', ({ data }) => !data.draft);
	const sorted = posts.sort(
		(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
	);
	const lastPage = Math.max(1, Math.ceil(sorted.length / PAGE_SIZE));

	const paths = [];
	for (let p = 2; p <= lastPage; p++) {
		const start = (p - 1) * PAGE_SIZE;
		paths.push({
			params: { page: String(p) },
			props: {
				posts: sorted.slice(start, start + PAGE_SIZE),
				current: p,
				last: lastPage,
				prevUrl: p === 2 ? '/blog' : `/blog/page/${p - 1}`,
				nextUrl: p < lastPage ? `/blog/page/${p + 1}` : null,
			},
		});
	}
	return paths;
}

const { posts, current, last, prevUrl, nextUrl } = Astro.props;
---

<BaseLayout title={`Blog - 第 ${current} 页 - yuzhiblue`} description="开发笔记与技术思考">
	<style>
		.page-header { padding: 40px 0; border-bottom: 1px solid var(--border); margin-bottom: 40px; }
		.page-header h1 { font-size: 2rem; font-weight: 700; letter-spacing: -0.02em; margin-bottom: 8px; }
		.page-header p { color: var(--text-muted); }
		.empty { color: var(--text-muted); padding: 40px 0; text-align: center; }
	</style>

	<div class="page-header">
		<h1>Blog</h1>
		<p>开发笔记、技术分享和产品思考</p>
	</div>

	{posts.length === 0 ? (
		<p class="empty">暂无文章，敬请期待。</p>
	) : (
		posts.map((post) => <PostCard post={post} />)
	)}

	<Pagination current={current} last={last} prevUrl={prevUrl} nextUrl={nextUrl} baseUrl="/blog" />
</BaseLayout>
