---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { blogPostingSchema } from '../../lib/seo';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
	// 过滤 draft：否则下线文章仍会生成详情页 URL 并进入 sitemap，列表隐藏形同虚设
	const posts = await getCollection('blog', ({ data }) => !data.draft);
	return posts.map((post) => ({
		params: { slug: post.id },
		props: { post },
	}));
}

const { post } = Astro.props;
const { Content } = await render(post);

const readingTime = (() => {
  const text = post.body ?? '';
  const cjk = (text.match(/[一-龥]/g) || []).length;
  const words = (text.replace(/[一-龥]/g, ' ').match(/\b\w+\b/g) || []).length;
  const minutes = Math.max(1, Math.round(cjk / 400 + words / 200));
  return minutes;
})();

// 全部文章按 pubDate 降序，确定上一篇/下一篇
const allPosts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const idx = allPosts.findIndex((p) => p.id === post.id);
const prevPost = idx >= 0 && idx < allPosts.length - 1 ? allPosts[idx + 1] : null; // 时间更早
const nextPost = idx > 0 ? allPosts[idx - 1] : null; // 时间更晚

// 相关推荐：同标签 top 3，不足补最新
const currentTags = new Set(post.data.tags);
const related = allPosts
  .filter((p) => p.id !== post.id)
  .map((p) => ({
    post: p,
    score: p.data.tags.filter((t) => currentTags.has(t)).length,
  }))
  .sort((a, b) => b.score - a.score || b.post.data.pubDate.valueOf() - a.post.data.pubDate.valueOf())
  .slice(0, 3)
  .map((r) => r.post);
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  type="article"
  image={post.data.coverImage}
  schema={blogPostingSchema(post)}
>
  <style>
    .article { max-width: 760px; margin: 0 auto; }
    .article-header { margin-bottom: 40px; padding-bottom: 24px; border-bottom: 1px solid var(--border); }
    .article-header h1 { font-size: 2.2rem; font-weight: 800; letter-spacing: -0.03em; line-height: 1.2; margin-bottom: 16px; }
    .article-author { display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap; }
    .author-link { display: inline-flex; align-items: center; gap: 10px; color: var(--text); font-size: 0.95rem; font-weight: 500; transition: color 0.2s; }
    .author-link:hover { color: var(--accent); }
    .author-avatar { width: 32px; height: 32px; border-radius: 50%; object-fit: cover; border: 1px solid var(--border); background: var(--card-bg); }
    .article-meta { display: flex; align-items: center; gap: 16px; color: var(--text-muted); font-size: 0.9rem; }
    .article-tags { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 16px; }
    .article-tag { background: var(--bg-secondary); color: var(--text-muted); font-size: 0.75rem; padding: 4px 12px; border-radius: 20px; border: 1px solid var(--border); text-decoration: none; transition: border-color 0.2s, color 0.2s; }
    .article-tag:hover { border-color: var(--accent); color: var(--accent); }
    /* Markdown 内容（<Content/> 渲染，无 scoped cid）必须用 :global 完全跳出作用域 */
    :global(.article-content) { font-size: 1.05rem; line-height: 1.8; }
    :global(.article-content h2) { font-size: 1.5rem; font-weight: 700; margin: 48px 0 16px; letter-spacing: -0.02em; }
    :global(.article-content h3) { font-size: 1.2rem; font-weight: 600; margin: 32px 0 12px; }
    :global(.article-content p) { margin-bottom: 20px; color: var(--text-muted); }
    :global(.article-content code) { background: var(--bg-secondary); padding: 2px 6px; border-radius: 4px; font-size: 0.9em; font-family: 'SF Mono', Monaco, monospace; }
    :global(.article-content pre) { background: var(--bg-secondary); border: 1px solid var(--border); border-radius: 8px; padding: 20px; overflow-x: auto; margin: 24px 0; }
    :global(.article-content pre code) { background: none; padding: 0; }
    :global(.article-content blockquote) { border-left: 3px solid var(--accent); padding-left: 20px; margin: 24px 0; color: var(--text-muted); }
    :global(.article-content ul), :global(.article-content ol) { margin: 16px 0; padding-left: 24px; }
    :global(.article-content li) { margin-bottom: 8px; color: var(--text-muted); }
    :global(.article-content img) {
      display: block; max-width: 100%; height: auto;
      border-radius: 12px; border: 1px solid var(--border);
      margin: 28px auto; background: var(--card-bg);
    }
    :global(.article-content a) { color: var(--link); text-decoration: underline; text-underline-offset: 4px; }
    :global(.article-content a:hover) { color: var(--link-hover); }
    :global(.article-content table) { width: 100%; border-collapse: collapse; margin: 24px 0; font-size: 0.95rem; }
    :global(.article-content th), :global(.article-content td) { border: 1px solid var(--border); padding: 10px 14px; text-align: left; }
    :global(.article-content th) { background: var(--bg-secondary); color: var(--text); }
    .back-link { display: inline-flex; align-items: center; gap: 6px; color: var(--text-muted); font-size: 0.9rem; margin-bottom: 32px; transition: color 0.2s; }
    .back-link:hover { color: var(--accent); }
    .post-nav { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-top: 48px; padding-top: 32px; border-top: 1px solid var(--border); }
    .post-nav-link {
      display: flex; flex-direction: column; gap: 6px; padding: 16px 20px;
      background: var(--card-bg); border: 1px solid var(--border); border-radius: 10px;
      text-decoration: none; transition: border-color 0.2s, transform 0.2s;
    }
    .post-nav-link:hover { border-color: var(--accent); transform: translateY(-2px); }
    .post-nav-link.next { text-align: right; }
    .post-nav-link.empty { visibility: hidden; }
    .post-nav-label { color: var(--text-muted); font-size: 0.8rem; }
    .post-nav-title { color: var(--text); font-size: 0.95rem; font-weight: 500; }
    .post-nav-link:hover .post-nav-title { color: var(--accent); }
    .related { margin-top: 48px; padding-top: 32px; border-top: 1px solid var(--border); }
    .related-title { font-size: 1.3rem; font-weight: 700; letter-spacing: -0.02em; margin-bottom: 20px; color: var(--text); }
    .related-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; align-items: stretch; }
    @media (max-width: 768px) {
      .post-nav { grid-template-columns: 1fr; }
      .post-nav-link.next { text-align: left; }
      .related-grid { grid-template-columns: 1fr; }
    }
    @media (max-width: 480px) {
      .article-author { flex-direction: column; align-items: flex-start; }
      .article-header h1 { font-size: 1.8rem; }
    }
  </style>

  <article class="article">
    <a href="/blog/" class="back-link">← Back to blog</a>
    <header class="article-header">
      <h1>{post.data.title}</h1>
      <div class="article-author">
        <a class="author-link" href="/about/">
          <img class="author-avatar" src="/avatar.svg" alt="yuzhiblue" width="32" height="32" decoding="async" />
          yuzhiblue
        </a>
        <div class="article-meta">
          <time datetime={post.data.pubDate.toISOString()}>
            {post.data.pubDate.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' })}
          </time>
          <span>·</span>
          <span>{readingTime} 分钟阅读</span>
          {post.data.updatedDate && (
            <span>（更新于 {post.data.updatedDate.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' })}）</span>
          )}
        </div>
      </div>
      {post.data.tags.length > 0 && (
        <div class="article-tags">
          {post.data.tags.map((tag) => (
            <a class="article-tag" href={`/blog/tag/${encodeURIComponent(tag)}/`}>{tag}</a>
          ))}
        </div>
      )}
    </header>
    <div class="article-content"><Content /></div>

    {(prevPost || nextPost) && (
      <nav class="post-nav" aria-label="上一篇/下一篇">
        {prevPost ? (
          <a class="post-nav-link prev" href={`/blog/${prevPost.id}/`}>
            <span class="post-nav-label">← 上一篇</span>
            <span class="post-nav-title">{prevPost.data.title}</span>
          </a>
        ) : (
          <span class="post-nav-link empty" aria-hidden="true"></span>
        )}
        {nextPost ? (
          <a class="post-nav-link next" href={`/blog/${nextPost.id}/`}>
            <span class="post-nav-label">下一篇 →</span>
            <span class="post-nav-title">{nextPost.data.title}</span>
          </a>
        ) : (
          <span class="post-nav-link empty" aria-hidden="true"></span>
        )}
      </nav>
    )}

    {related.length > 0 && (
      <section class="related" aria-label="相关推荐">
        <h2 class="related-title">相关推荐</h2>
        <div class="related-grid">
          {related.map((p) => (
            <PostCard post={p} compact />
          ))}
        </div>
      </section>
    )}
  </article>
</BaseLayout>
