---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import PostCard from '../../components/PostCard.astro';
import Pagination from '../../components/Pagination.astro';

const PAGE_SIZE = 12;

const posts = await getCollection('blog', ({ data }) => !data.draft);
const sortedPosts = posts.sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const pagePosts = sortedPosts.slice(0, PAGE_SIZE);
const lastPage = Math.max(1, Math.ceil(sortedPosts.length / PAGE_SIZE));
---

<BaseLayout title="Blog - yuzhiblue" description="开发笔记与技术思考">
	<style>
		.page-header { padding: 40px 0; border-bottom: 1px solid var(--border); margin-bottom: 40px; }
		.page-header h1 { font-size: 2rem; font-weight: 700; letter-spacing: -0.02em; margin-bottom: 8px; }
		.page-header p { color: var(--text-muted); }
		.empty { color: var(--text-muted); padding: 40px 0; text-align: center; }
	</style>

	<div class="page-header">
		<h1>Blog</h1>
		<p>开发笔记、技术分享和产品思考</p>
	</div>

	{pagePosts.length === 0 ? (
		<p class="empty">暂无文章，敬请期待。</p>
	) : (
		pagePosts.map((post) => <PostCard post={post} />)
	)}

	<Pagination
		current={1}
		last={lastPage}
		prevUrl={null}
		nextUrl={lastPage > 1 ? '/blog/page/2' : null}
	/>
</BaseLayout>
