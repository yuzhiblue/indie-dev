---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import ProjectCard from '../../components/ProjectCard.astro';
import Pagination from '../../components/Pagination.astro';
import { collectionSchema } from '../../lib/seo';

const PAGE_SIZE = 12;

import { dedupeProjects } from '../../lib/projects-i18n';

const projects = await getCollection('projects', ({ data }) => !data.draft);
const sortedProjects = dedupeProjects(projects).sort((a, b) => {
	const aFeatured = a.data.featured ? 1 : 0;
	const bFeatured = b.data.featured ? 1 : 0;
	if (aFeatured !== bFeatured) return bFeatured - aFeatured;
	const aDate = a.data.pubDate?.valueOf() ?? 0;
	const bDate = b.data.pubDate?.valueOf() ?? 0;
	return bDate - aDate;
});
const pageProjects = sortedProjects.slice(0, PAGE_SIZE);
const lastPage = Math.max(1, Math.ceil(sortedProjects.length / PAGE_SIZE));
---

<BaseLayout
	title="项目"
	description="yuzhiblue 独立开发与维护的产品与工具集合：面向抖音、快手、视频号的直播定时开播与下播助手（Doutimer、Kwaitimer、Wxtimer）、OBS Studio 定时推流插件（OBStimer），以及仍在打磨中的其他 Windows 桌面效率工具，每个项目都附带功能说明与使用教程。"
	schema={collectionSchema({
		name: '项目',
		description: 'yuzhiblue 独立开发与维护的产品与工具：Windows 直播定时助手、OBS 插件与开源项目。',
		path: '/projects/',
	})}
>
	<style>
		.page-header { padding: 40px 0; border-bottom: 1px solid var(--border); margin-bottom: 40px; }
		.page-header h1 { font-size: 2rem; font-weight: 700; letter-spacing: -0.02em; margin-bottom: 8px; }
		.page-header p { color: var(--text-muted); }
		.empty { color: var(--text-muted); padding: 40px 0; text-align: center; }
	</style>

	<div class="page-header">
		<h1>Projects</h1>
		<p>我独立开发与维护的产品、工具与开源项目</p>
	</div>

	{pageProjects.length === 0 ? (
		<p class="empty">暂无项目，敬请期待。</p>
	) : (
		pageProjects.map((project) => <ProjectCard project={project} />)
	)}

	<Pagination
		current={1}
		last={lastPage}
		prevUrl={null}
		nextUrl={lastPage > 1 ? '/projects/page/2/' : null}
		baseUrl="/projects"
	/>
</BaseLayout>
