---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import { baseKeyOf, dedupeProjects, langMeta } from '../../lib/projects-i18n';
import { softwareApplicationSchema } from '../../lib/seo';

// Per-language UI chrome (back link, "updated" label, date locale)
const LANG_CHROME: Record<string, { back: string; updatedPre: string; updatedPost: string; dateLocale: string }> = {
  zh: { back: '← 返回项目', updatedPre: '（更新于 ', updatedPost: '）', dateLocale: 'zh-CN' },
  en: { back: '← Back to projects', updatedPre: '(Updated ', updatedPost: ')', dateLocale: 'en-US' },
  ja: { back: '← プロジェクト一覧へ', updatedPre: '（更新日: ', updatedPost: '）', dateLocale: 'ja-JP' },
};

// Per-language action button labels (download / purchase / etc.)
const LANG_ACTIONS: Record<string, { demo: string; purchase: string; download: string; website: string; github: string }> = {
  zh: { demo: '在线演示 ↗', purchase: '立即购买 ↗', download: '下载 ↗', website: '访问官网 ↗', github: 'GitHub 源码 ↗' },
  en: { demo: 'Live Demo ↗', purchase: 'Buy Now ↗', download: 'Download ↗', website: 'Visit Website ↗', github: 'GitHub Repo ↗' },
  ja: { demo: 'デモを見る ↗', purchase: '購入する ↗', download: 'ダウンロード ↗', website: '公式サイトへ ↗', github: 'GitHub リポジトリ ↗' },
};

export async function getStaticPaths() {
  const all = await getCollection('projects', ({ data }) => !data.draft);
  // Group translations that share the same i18n base key
  const groups = new Map<string, typeof all>();
  for (const p of all) {
    const k = baseKeyOf(p);
    if (!groups.has(k)) groups.set(k, []);
    groups.get(k)!.push(p);
  }
  // 每个项目组的代表（优先中文），用于「相关项目」互链
  const representatives = dedupeProjects(all);
  return all.map((project) => {
    const group = groups.get(baseKeyOf(project)) ?? [project];
    const siblings = group.map((p) => {
      const lang = p.data.lang ?? 'zh';
      const meta = langMeta(lang);
      return { slug: p.id, lang, label: meta.label, code: meta.code };
    });
    const related = representatives
      .filter((p) => baseKeyOf(p) !== baseKeyOf(project))
      .slice(0, 3);
    return { params: { slug: project.id }, props: { project, siblings, related } };
  });
}

const { project, siblings, related } = Astro.props;
const { Content } = await render(project);

const lang = project.data.lang ?? 'zh';
const meta = langMeta(lang);
const chrome = LANG_CHROME[lang] ?? LANG_CHROME.zh;
const actions = LANG_ACTIONS[lang] ?? LANG_ACTIONS.zh;

const site = Astro.site ?? new URL('https://7tec.cn');
const absUrl = (slug: string) => new URL(`/projects/${slug}/`, site).toString();
const mainSibling = siblings.find((s) => s.lang === 'zh') ?? siblings[0];
const showSwitch = siblings.length > 1;
const RELATED_TITLES: Record<string, string> = {
  zh: '相关项目',
  en: 'Related projects',
  ja: '関連プロジェクト',
};
const relatedTitle = RELATED_TITLES[lang] ?? RELATED_TITLES.zh;
---

<BaseLayout
  title={project.data.title}
  description={project.data.description}
  lang={meta.code}
  wide
  image={project.data.coverImage}
  schema={softwareApplicationSchema(project, meta.code)}
>
  <Fragment slot="head">
    {showSwitch && siblings.map((s) => (
      <link rel="alternate" hreflang={s.code} href={absUrl(s.slug)} />
    ))}
    {showSwitch && <link rel="alternate" hreflang="x-default" href={absUrl(mainSibling.slug)} />}
  </Fragment>

  <style is:raw>
    .article { max-width: none; margin: 0 auto; }
    .cover {
      width: 100%; aspect-ratio: 16 / 9; object-fit: cover;
      border-radius: 16px; border: 1px solid var(--border);
      margin: 0 0 32px; background: var(--card-bg);
    }
    .cover-placeholder {
      width: 100%; aspect-ratio: 16 / 9;
      border-radius: 16px; border: 1px solid var(--border);
      margin: 0 0 32px; background: linear-gradient(135deg, #e9e4d8 0%, #d9d4c8 100%);
    }
    .article-header { margin-bottom: 32px; display: flex; align-items: flex-start; justify-content: space-between; gap: 24px; flex-wrap: wrap; }
    .article-header-left { min-width: 0; flex: 1; }
    .article-header h1 { font-size: 2.2rem; font-weight: 800; letter-spacing: -0.03em; line-height: 1.2; margin-bottom: 16px; }
    .article-meta { display: flex; align-items: center; gap: 16px; color: var(--text-muted); font-size: 0.9rem; flex-wrap: wrap; }
    .article-tags { display: flex; gap: 8px; margin-top: 16px; flex-wrap: wrap; }
    .article-tag { background: var(--bg-secondary); color: var(--text-muted); font-size: 0.75rem; padding: 4px 12px; border-radius: 20px; border: 1px solid var(--border); }
    .article-actions { display: flex; flex-direction: column; gap: 12px; flex-shrink: 0; align-items: stretch; }
    .btn {
      display: inline-flex; align-items: center; gap: 8px; font-size: 0.9rem; font-weight: 600;
      padding: 10px 18px; border-radius: 10px; transition: all 0.2s; border: 1px solid transparent;
    }
    .btn-primary { background: var(--accent-strong); color: #fff; }
    .btn-primary:hover { background: var(--accent-hover); color: #fff; }
    .btn-outline { background: transparent; color: var(--text); border-color: var(--border); }
    .btn-outline:hover { border-color: var(--link); color: var(--link); }
    /* Language switcher (Plan B: per-language content files) */
    .lang-switch { display: flex; align-items: center; gap: 8px; margin-bottom: 24px; flex-wrap: wrap; }
    .lang-switch-label { font-size: 0.8rem; color: var(--text-muted); }
    .lang-switch a {
      font-size: 0.85rem; padding: 5px 14px; border-radius: 20px;
      border: 1px solid var(--border); color: var(--text-muted); transition: all 0.2s;
    }
    .lang-switch a:hover { border-color: var(--link); color: var(--link); }
    .lang-switch a[aria-current='true'] { background: var(--accent-strong); color: #fff; border-color: var(--accent-strong); }
    /* Markdown content (<Content/> renders without a scoped cid, so :global is required) */
    :global(.article-content) { font-size: 1.05rem; line-height: 1.8; }
    :global(.article-content h2) { font-size: 1.5rem; font-weight: 700; margin: 48px 0 16px; letter-spacing: -0.02em; }
    :global(.article-content h3) { font-size: 1.2rem; font-weight: 600; margin: 32px 0 12px; }
    :global(.article-content p) { margin-bottom: 20px; color: var(--text-muted); }
    :global(.article-content code) { background: var(--bg-secondary); padding: 2px 6px; border-radius: 4px; font-size: 0.9em; font-family: 'SF Mono', Monaco, monospace; }
    :global(.article-content pre) { background: var(--bg-secondary); border: 1px solid var(--border); border-radius: 8px; padding: 20px; overflow-x: auto; margin: 24px 0; }
    :global(.article-content pre code) { background: none; padding: 0; }
    :global(.article-content blockquote) { border-left: 3px solid var(--accent); padding-left: 20px; margin: 24px 0; color: var(--text-muted); }
    :global(.article-content ul), :global(.article-content ol) { margin: 16px 0; padding-left: 24px; }
    :global(.article-content li) { margin-bottom: 8px; color: var(--text-muted); }
    :global(.article-content img) {
      display: block; max-width: 100%; height: auto;
      border-radius: 12px; border: 1px solid var(--border);
      margin: 28px auto; background: var(--card-bg);
    }
    :global(.article-content a) { color: var(--link); text-decoration: underline; text-underline-offset: 4px; }
    :global(.article-content a:hover) { color: var(--link-hover); }
    :global(.article-content table) { width: 100%; border-collapse: collapse; margin: 24px 0; font-size: 0.95rem; }
    :global(.article-content th), :global(.article-content td) { border: 1px solid var(--border); padding: 10px 14px; text-align: left; }
    :global(.article-content th) { background: var(--bg-secondary); color: var(--text); }
    .back-link { display: inline-flex; align-items: center; gap: 6px; color: var(--text-muted); font-size: 0.9rem; margin-bottom: 24px; transition: color 0.2s; }
    .back-link:hover { color: var(--accent); }
    /* 相关项目互链 */
    .related { margin-top: 64px; padding-top: 32px; border-top: 1px solid var(--border); }
    .related-title { font-size: 1.3rem; font-weight: 700; letter-spacing: -0.02em; margin-bottom: 20px; color: var(--text); }
    .related-list { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px; }
    .related-item {
      display: flex; flex-direction: column; gap: 12px; padding: 16px;
      background: var(--card-bg); border: 1px solid var(--border); border-radius: 12px;
      transition: border-color 0.2s, transform 0.2s;
    }
    .related-item:hover { border-color: var(--accent); transform: translateY(-2px); }
    .related-thumb {
      width: 100%; aspect-ratio: 16 / 9; object-fit: cover;
      border-radius: 8px; border: 1px solid var(--border); background: var(--bg-secondary);
    }
    .related-name { display: block; font-size: 0.95rem; font-weight: 600; color: var(--text); }
    .related-desc {
      display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
      font-size: 0.82rem; color: var(--text-muted); line-height: 1.6;
    }
    .related-item:hover .related-name { color: var(--accent); }
    @media (max-width: 768px) {
      .article-header { flex-direction: column; }
      .article-actions { flex-direction: row; flex-wrap: wrap; align-items: flex-start; }
      .btn { flex: 0 0 auto; }
    }
    @media (max-width: 640px) {
      .article-header h1 { font-size: 1.8rem; }
    }
  </style>

  <article class="article">
    <a href="/projects/" class="back-link">{chrome.back}</a>
    {showSwitch && (
      <nav class="lang-switch" aria-label="语言版本">
        <span class="lang-switch-label">语言</span>
        {siblings.map((s) => (
          <a
            href={`/projects/${s.slug}/`}
            hreflang={s.code}
            aria-current={s.slug === project.id ? 'true' : undefined}
          >{s.label}</a>
        ))}
      </nav>
    )}
    <header class="article-header">
      <div class="article-header-left">
        <h1>{project.data.title}</h1>
        <div class="article-meta">
          {project.data.pubDate && (
            <time datetime={project.data.pubDate.toISOString()}>
              {project.data.pubDate.toLocaleDateString(chrome.dateLocale, { year: 'numeric', month: 'long', day: 'numeric' })}
            </time>
          )}
          {project.data.updatedDate && (
            <span>{chrome.updatedPre}{project.data.updatedDate.toLocaleDateString(chrome.dateLocale, { year: 'numeric', month: 'long', day: 'numeric' })}{chrome.updatedPost}</span>
          )}
        </div>
        {project.data.tags.length > 0 && (
          <div class="article-tags">
            {project.data.tags.map((tag) => (<span class="article-tag">{tag}</span>))}
          </div>
        )}
      </div>
      {(project.data.demo || project.data.purchase || project.data.download || project.data.website || project.data.github) && (
        <div class="article-actions">
          {project.data.demo && (
            <a href={project.data.demo} target="_blank" rel="noopener" class="btn btn-primary">{actions.demo}</a>
          )}
          {project.data.purchase && (
            <a href={project.data.purchase} target="_blank" rel="noopener" class="btn btn-primary">{actions.purchase}</a>
          )}
          {project.data.download && (
            <a href={project.data.download} target="_blank" rel="noopener" class="btn btn-outline">{actions.download}</a>
          )}
          {project.data.website && (
            <a href={project.data.website} target="_blank" rel="noopener" class="btn btn-outline">{actions.website}</a>
          )}
          {project.data.github && (
            <a href={project.data.github} target="_blank" rel="noopener" class="btn btn-outline">{actions.github}</a>
          )}
        </div>
      )}
    </header>
    {project.data.coverImage ? (
      <img
        src={project.data.coverImage}
        alt={`${project.data.title} 封面`}
        class="cover"
        decoding="async"
        fetchpriority="high"
      />
    ) : (
      <div class="cover-placeholder" role="img" aria-label={`${project.data.title} 封面`}></div>
    )}
    <div class="article-content"><Content /></div>

    {related.length > 0 && (
      <section class="related" aria-label={relatedTitle}>
        <h2 class="related-title">{relatedTitle}</h2>
        <div class="related-list">
          {related.map((p) => (
            <a class="related-item" href={`/projects/${p.id}/`}>
              {p.data.coverImage ? (
                <img
                  class="related-thumb"
                  src={p.data.coverImage}
                  alt={`${p.data.title} 封面`}
                  loading="lazy"
                  decoding="async"
                />
              ) : (
                <div class="related-thumb" aria-hidden="true"></div>
              )}
              <span class="related-name">{p.data.title}</span>
              <span class="related-desc">{p.data.description}</span>
            </a>
          ))}
        </div>
      </section>
    )}
  </article>
</BaseLayout>
