---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import ProjectCard from '../../../components/ProjectCard.astro';
import Pagination from '../../../components/Pagination.astro';
import { dedupeProjects } from '../../../lib/projects-i18n';

export async function getStaticPaths() {
	const PAGE_SIZE = 12;

	const projects = await getCollection('projects', ({ data }) => !data.draft);
	const sorted = dedupeProjects(projects).sort((a, b) => {
		const aFeatured = a.data.featured ? 1 : 0;
		const bFeatured = b.data.featured ? 1 : 0;
		if (aFeatured !== bFeatured) return bFeatured - aFeatured;
		const aDate = a.data.pubDate?.valueOf() ?? 0;
		const bDate = b.data.pubDate?.valueOf() ?? 0;
		return bDate - aDate;
	});
	const lastPage = Math.max(1, Math.ceil(sorted.length / PAGE_SIZE));

	const paths = [];
	for (let p = 2; p <= lastPage; p++) {
		const start = (p - 1) * PAGE_SIZE;
		paths.push({
			params: { page: String(p) },
			props: {
				projects: sorted.slice(start, start + PAGE_SIZE),
				current: p,
				last: lastPage,
				prevUrl: p === 2 ? '/projects' : `/projects/page/${p - 1}`,
				nextUrl: p < lastPage ? `/projects/page/${p + 1}` : null,
			},
		});
	}
	return paths;
}

const { projects, current, last, prevUrl, nextUrl } = Astro.props;
---

<BaseLayout title={`Projects - 第 ${current} 页 - yuzhiblue`} description="独立开发者的项目作品集">
	<style>
		.page-header { padding: 40px 0; border-bottom: 1px solid var(--border); margin-bottom: 40px; }
		.page-header h1 { font-size: 2rem; font-weight: 700; letter-spacing: -0.02em; margin-bottom: 8px; }
		.page-header p { color: var(--text-muted); }
		.empty { color: var(--text-muted); padding: 40px 0; text-align: center; }
	</style>

	<div class="page-header">
		<h1>Projects</h1>
		<p>我独立开发与维护的产品、工具与开源项目</p>
	</div>

	{projects.length === 0 ? (
		<p class="empty">暂无项目，敬请期待。</p>
	) : (
		projects.map((project) => <ProjectCard project={project} />)
	)}

	<Pagination current={current} last={last} prevUrl={prevUrl} nextUrl={nextUrl} baseUrl="/projects" />
</BaseLayout>
