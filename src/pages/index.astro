---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const projects = await getCollection('projects', ({ data }) => !data.draft);
const featuredProjects = projects
  .sort((a, b) => {
    const aFeatured = a.data.featured ? 1 : 0;
    const bFeatured = b.data.featured ? 1 : 0;
    if (aFeatured !== bFeatured) return bFeatured - aFeatured;
    const aDate = a.data.pubDate?.valueOf() ?? 0;
    const bDate = b.data.pubDate?.valueOf() ?? 0;
    return bDate - aDate;
  });

const recentPosts = await getCollection('blog', ({ data }) => !data.draft);
const featuredPosts = recentPosts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 5);

const socialLinks = [
  {
    label: 'GitHub',
    href: 'https://github.com/yuzhiblue',
    note: '@yuzhiblue',
    icon: '<svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><path d="M12 .5C5.7.5.5 5.7.5 12c0 5.1 3.3 9.4 7.9 10.9.6.1.8-.3.8-.6v-2c-3.2.7-3.9-1.5-3.9-1.5-.5-1.3-1.3-1.7-1.3-1.7-1.1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 .1.8 1.7 2.6 1.2.1-.7.4-1.2.7-1.5-2.6-.3-5.3-1.3-5.3-5.7 0-1.3.5-2.3 1.2-3.1-.1-.3-.5-1.5.1-3.1 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0C17.3 4.6 18.3 5 18.3 5c.6 1.6.2 2.8.1 3.1.8.8 1.2 1.8 1.2 3.1 0 4.4-2.7 5.4-5.3 5.7.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6 4.6-1.5 7.9-5.8 7.9-10.9C23.5 5.7 18.3.5 12 .5z"/></svg>',
  },
  {
    label: 'X',
    href: 'https://x.com/yuzhiblue',
    note: '@yuzhiblue',
    icon: '<svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M18.2 2H21l-6.6 7.6L22 22h-6.2l-4.9-6.4L5.2 22H2.4l7-8.1L2 2h6.4l4.4 5.9L18.2 2zm-1.1 18h1.7L7 3.9H5.2L17.1 20z"/></svg>',
  },
  {
    label: '公众号',
    href: '#',
    note: '搜索 7TEC 关注',
    icon: '<svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><path d="M8.7 3C4.5 3 1 5.9 1 9.5c0 2.3 1.3 4.3 3.4 5.6L3.3 18l2.9-1.5c.9.2 1.8.4 2.5.4h.4a6 6 0 0 1-.2-1.6c0-3.6 3.4-6.4 7.6-6.4h.4C16.5 4.9 12.9 3 8.7 3zm-2.6 4.2a1.1 1.1 0 1 1 0 2.2 1.1 1.1 0 0 1 0-2.2zm5.2 0a1.1 1.1 0 1 1 0 2.2 1.1 1.1 0 0 1 0-2.2zM16 9.8c-3.3 0-6 2.4-6 5.4 0 3 2.7 5.4 6 5.4.6 0 1.2-.1 1.8-.3l2.5 1.3-.7-2.3c1.4-1 2.3-2.5 2.3-4.1 0-3-2.7-5.4-6-5.4zm-2 3.7a.9.9 0 1 1 0 1.8.9.9 0 0 1 0-1.8zm4 0a.9.9 0 1 1 0 1.8.9.9 0 0 1 0-1.8z"/></svg>',
  },
];
---

<BaseLayout title="Home - yuzhiblue" description="独立开发者作品展示">
  <style>
    .hero { padding: 80px 0 60px; text-align: center; }
    .hero-avatar {
      width: 96px; height: 96px; border-radius: 50%;
      margin: 0 auto 24px; object-fit: cover;
      border: 1px solid var(--border); background: var(--card-bg);
    }
    .hero h1 {
      font-size: 3rem; font-weight: 800; letter-spacing: -0.03em;
      margin-bottom: 16px;
      background: linear-gradient(135deg, #fff 0%, #888 100%);
      -webkit-background-clip: text; -webkit-text-fill-color: transparent;
    }
    .hero p { color: var(--text-muted); font-size: 1.15rem; max-width: 500px; margin: 0 auto 32px; }
    section { margin-bottom: 72px; }
    .section-title {
      font-size: 1.1rem; font-weight: 600; color: var(--text);
      margin-bottom: 24px; display: flex; align-items: center; gap: 12px;
    }
    .section-title::before {
      content: ''; width: 4px; height: 20px; background: var(--accent);
      border-radius: 2px;
    }
    .projects-grid {
      display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
      gap: 20px; margin-bottom: 60px;
    }
    .project-card {
      background: var(--card-bg); border: 1px solid var(--border);
      border-radius: 12px; overflow: hidden; transition: border-color 0.2s, transform 0.2s;
    }
    .project-card:hover { border-color: var(--accent); transform: translateY(-2px); }
    .project-cover {
      width: 100%; aspect-ratio: 16 / 9; object-fit: cover; display: block;
      background: linear-gradient(135deg, #1e1e2e 0%, #2a2a3e 100%);
    }
    .project-body { padding: 24px; }
    .project-card h3 { font-size: 1.1rem; font-weight: 600; margin-bottom: 8px; }
    .project-card h3 a { color: var(--text); }
    .project-card h3 a:hover { color: var(--accent); }
    .project-card p { color: var(--text-muted); font-size: 0.9rem; margin-bottom: 16px; line-height: 1.5; }
    .tags { display: flex; flex-wrap: wrap; gap: 8px; }
    .tag {
      background: var(--bg-secondary); color: var(--text-muted);
      font-size: 0.75rem; padding: 4px 10px; border-radius: 20px; border: 1px solid var(--border);
    }
    .featured-badge {
      display: inline-block; background: var(--accent); color: #fff;
      font-size: 0.7rem; padding: 2px 8px; border-radius: 20px;
      margin-left: 8px; font-weight: 600;
    }
      .posts-section { padding-top: 40px; border-top: 1px solid var(--border); }
    .post-list { display: flex; flex-direction: column; gap: 12px; }
    .post-item {
      display: flex; justify-content: space-between; align-items: center;
      padding: 16px 20px; background: var(--card-bg); border: 1px solid var(--border);
      border-radius: 10px; transition: border-color 0.2s;
    }
    .post-item:hover { border-color: var(--accent); transform: translateY(-2px); }
    .post-main { min-width: 0; }
    .post-item a { color: var(--text); font-weight: 500; font-size: 0.95rem; }
    .post-item a:hover { color: var(--accent); }
    .post-date { color: var(--text-muted); font-size: 0.8rem; white-space: nowrap; margin-left: 16px; }
    .post-badge {
      display: inline-block; margin-left: 10px; vertical-align: middle;
      background: var(--accent); color: #fff; font-size: 0.68rem; font-weight: 600;
      padding: 1px 7px; border-radius: 20px; letter-spacing: 0.02em;
    }
    .view-all { display: inline-block; margin-top: 20px; color: var(--accent); font-size: 0.9rem; font-weight: 500; }
    .view-all:hover { color: var(--accent-hover); }
    .follow {
      max-width: 560px; margin: 0 auto; text-align: center;
    }
    .follow h2 { font-size: 1.2rem; font-weight: 600; margin-bottom: 8px; color: var(--text); }
    .follow > p { color: var(--text-muted); font-size: 0.9rem; margin-bottom: 24px; }
    .follow-links { display: flex; flex-wrap: wrap; gap: 12px; justify-content: center; }
    .follow-link {
      display: inline-flex; align-items: center; justify-content: center;
      background: transparent; border: 1px solid var(--border);
      color: var(--text); padding: 12px; border-radius: 10px;
      transition: border-color 0.2s, transform 0.2s, color 0.2s;
    }
    .follow-link:link, .follow-link:visited { color: var(--text); }
    .follow-link:hover { border-color: var(--accent); transform: translateY(-2px); color: var(--accent); }
    .follow-icon { display: inline-flex; line-height: 0; }
    .follow-icon :global(svg) { display: block; }
    @media (max-width: 640px) {
      .hero h1 { font-size: 2rem; }
      .projects-grid { grid-template-columns: 1fr; }
    }
  </style>

  <section class="hero">
    <img class="hero-avatar" src="/favicon.svg" alt="yuzhiblue" width="96" height="96" />
    <h1>Hi, I'm yuzhiblue</h1>
    <p>独立开发者,专注于打造简洁实用的开发者工具与产品。相信小而美的工具能让日常更高效。</p>
  </section>

  <section>
    <h2 class="section-title">Projects</h2>
    <div class="projects-grid">
      {featuredProjects.map((project) => (
        <article class="project-card">
          {project.data.coverImage ? (
            <img class="project-cover" src={project.data.coverImage} alt={project.data.title} loading="lazy" />
          ) : (
            <div class="project-cover" role="img" aria-label={project.data.title}></div>
          )}
          <div class="project-body">
            <h3>
              <a href={`/projects/${project.id}`}>
                {project.data.title}
                {project.data.featured && <span class="featured-badge">Featured</span>}
              </a>
            </h3>
            <p>{project.data.description}</p>
            <div class="tags">
              {project.data.tags.map((tag) => (<span class="tag">{tag}</span>))}
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="posts-section">
    <h2 class="section-title">Latest Posts</h2>
    <div class="post-list">
      {featuredPosts.map((post, i) => (
        <div class="post-item">
          <a href={`/blog/${post.id}`}>{post.data.title}{i === 0 && <span class="post-badge">Latest</span>}</a>
          <span class="post-date">
            {post.data.pubDate.toLocaleDateString('zh-CN', { year: 'numeric', month: 'short', day: 'numeric' })}
          </span>
        </div>
      ))}
    </div>
    <a href="/blog" class="view-all">View all posts →</a>
  </section>

  <section class="follow">
    <h2>关注我</h2>
    <p>在以下平台找到我，获取最新项目与分享</p>
    <div class="follow-links">
      {socialLinks.map((link) => (
        <a
          class="follow-link"
          href={link.href}
          target={link.href.startsWith('http') ? '_blank' : undefined}
          rel="noopener noreferrer"
          aria-label={`${link.label} ${link.note}`}
        >
          <span class="follow-icon" set:html={link.icon} />
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
