---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { dedupeProjects } from '../lib/projects-i18n';
import { personSchema, websiteSchema } from '../lib/seo';

const allProjects = await getCollection('projects', ({ data }) => !data.draft);
const projects = dedupeProjects(allProjects).sort((a, b) => {
  const aFeatured = a.data.featured ? 1 : 0;
  const bFeatured = b.data.featured ? 1 : 0;
  if (aFeatured !== bFeatured) return bFeatured - aFeatured;

  const aDate = a.data.pubDate?.valueOf() ?? 0;
  const bDate = b.data.pubDate?.valueOf() ?? 0;
  return bDate - aDate;
});

const featuredProject =
  projects.find((project) => project.data.featured && project.data.coverImage) ??
  projects.find((project) => project.data.coverImage);
const otherProjects = projects.filter((project) => project.id !== featuredProject?.id).slice(0, 3);

const recentPosts = await getCollection('blog', ({ data }) => !data.draft);
const featuredPosts = recentPosts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 5);

const formatDate = (date: Date) => date.toISOString().slice(0, 10).replaceAll('-', '.');
---

<BaseLayout
  title="7TEC - 独立开发者 | 直播工具、开源库与开发笔记"
  description="7TEC（yuzhiblue）的个人站点：独立开发者，专注 Windows 桌面自动化与直播工具。产品包括抖音、快手、视频号直播定时助手（Doutimer、Kwaitimer、Wxtimer）、OBS Studio 定时推流插件（OBStimer）与在线直播贴片水印工具；同时开源 MoonBit 生态的 diff、图像水印、向量数据库客户端等库，并分享 Python、PySide6、Astro 建站与独立开发变现的技术笔记。"
  rawTitle
  wide
  schema={[websiteSchema(), personSchema()]}
>
  <div class="home-page">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-main">
        <p class="eyebrow"><span class="eyebrow-mark" aria-hidden="true"></span>7TEC / 独立开发者工作室</p>
        <h1 id="hero-title">把想法做成工具，<br /><span>把经验写进笔记。</span></h1>
        <p class="hero-intro">
          我是 yuzhiblue，专注 Windows 桌面自动化与直播工具，也在 MoonBit 生态中开源实用工具库。
        </p>
        <div class="hero-actions">
          <a class="button button-primary" href="/projects/">看项目 <span aria-hidden="true">→</span></a>
          <a class="button button-secondary" href="/blog/">读笔记 <span aria-hidden="true">→</span></a>
        </div>
      </div>
      <aside class="hero-aside" aria-label="关注方向">
        <p class="aside-label">关注方向</p>
        <ul>
          <li>Windows 桌面自动化</li>
          <li>直播与效率工具</li>
          <li>MoonBit 开源库</li>
        </ul>
        <p class="aside-note">从真实需求出发，持续打磨小而实用的软件。</p>
      </aside>
    </section>

    <section class="projects-section" aria-labelledby="projects-title">
      <div class="section-heading">
        <div>
          <p class="section-kicker"><span aria-hidden="true">01</span> / 项目精选</p>
          <h2 id="projects-title">独立做出来的产品</h2>
        </div>
        <a class="section-link" href="/projects/">浏览全部项目 <span aria-hidden="true">→</span></a>
      </div>

      {featuredProject?.data.coverImage && (
        <article class="featured-project">
          <a class="featured-visual" href={`/projects/${featuredProject.id}/`}>
            <img
              src={featuredProject.data.coverImage}
              alt={`${featuredProject.data.title} 项目封面`}
              loading="eager"
              fetchpriority="high"
              decoding="async"
            />
            <span class="visual-label">精选项目</span>
          </a>
          <div class="featured-copy">
            <p class="project-overline">代表作品</p>
            <h3><a href={`/projects/${featuredProject.id}/`}>{featuredProject.data.title}</a></h3>
            <p class="featured-description">{featuredProject.data.description}</p>
            {featuredProject.data.tags.length > 0 && (
              <ul class="tag-list" aria-label={`${featuredProject.data.title} 标签`}>
                {featuredProject.data.tags.slice(0, 4).map((tag) => <li>{tag}</li>)}
              </ul>
            )}
            <a class="project-action" href={`/projects/${featuredProject.id}/`}>
              查看项目介绍 <span aria-hidden="true">↗</span>
            </a>
          </div>
        </article>
      )}

      {otherProjects.length > 0 && (
        <div class="project-grid" aria-label="其他项目">
          {otherProjects.map((project) => (
            <article class="project-card">
              {project.data.coverImage && (
                <a class="project-cover" href={`/projects/${project.id}/`}>
                  <img
                    src={project.data.coverImage}
                    alt={`${project.data.title} 项目封面`}
                    loading="lazy"
                    decoding="async"
                  />
                </a>
              )}
              <div class="project-card-copy">
                <h3><a href={`/projects/${project.id}/`}>{project.data.title}</a></h3>
                <p>{project.data.description}</p>
                {project.data.tags.length > 0 && (
                  <ul class="tag-list" aria-label={`${project.data.title} 标签`}>
                    {project.data.tags.slice(0, 3).map((tag) => <li>{tag}</li>)}
                  </ul>
                )}
              </div>
            </article>
          ))}
        </div>
      )}
    </section>

    <section class="notes-section" aria-labelledby="notes-title">
      <div class="section-heading notes-heading">
        <div>
          <p class="section-kicker"><span aria-hidden="true">02</span> / 开发记录</p>
          <h2 id="notes-title">最近写下的笔记</h2>
        </div>
        <a class="section-link" href="/blog/">全部开发笔记 <span aria-hidden="true">→</span></a>
      </div>

      <ol class="notes-list">
        {featuredPosts.map((post, index) => (
          <li>
            <a class="note-entry" href={`/blog/${post.id}/`}>
              <div class="note-meta">
                <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
                <span class="note-topic">{post.data.tags[0] ?? '开发笔记'}</span>
              </div>
              <div class="note-copy">
                <h3>{post.data.title}</h3>
                <p>{post.data.description}</p>
              </div>
              <span class="note-arrow" aria-hidden="true">↗</span>
            </a>
          </li>
        ))}
      </ol>
    </section>
  </div>

  <style>
    .home-page {
      --home-blue: #204fc5;
      width: 100%;
    }

    .home-page .hero {
      display: grid;
      grid-template-columns: minmax(0, 1.55fr) minmax(220px, 0.55fr);
      align-items: end;
      gap: clamp(36px, 7vw, 96px);
      padding: 76px 0 72px;
      border-bottom: 1px solid var(--border);
    }

    .eyebrow,
    .section-kicker,
    .project-overline,
    .aside-label {
      color: var(--text-muted);
      font-size: 0.78rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      line-height: 1.5;
    }

    .eyebrow {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 22px;
      letter-spacing: 0.04em;
    }

    .eyebrow-mark {
      width: 9px;
      height: 9px;
      background: #d0a13b;
      border-radius: 50%;
      flex: 0 0 auto;
    }

    .hero h1 {
      max-width: 820px;
      margin: 0;
      color: var(--text);
      font-size: clamp(2.35rem, 6.2vw, 4.5rem);
      font-weight: 800;
      letter-spacing: -0.055em;
      line-height: 1.2;
    }

    .hero h1 span {
      color: var(--home-blue);
    }

    .hero-intro {
      max-width: 650px;
      margin-top: 22px;
      color: var(--text-muted);
      font-size: 1.05rem;
      line-height: 1.9;
    }

    .hero-actions {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 12px 22px;
      margin-top: 28px;
    }

    .button {
      display: inline-flex;
      min-height: 46px;
      align-items: center;
      justify-content: center;
      gap: 12px;
      font-size: 0.94rem;
      font-weight: 700;
      text-decoration: none;
      transition: color 160ms ease, background-color 160ms ease, border-color 160ms ease;
    }

    .button-primary {
      padding: 0 18px;
      color: #fff;
      background: var(--home-blue);
      border: 1px solid var(--home-blue);
    }

    .button-primary:hover {
      color: #fff;
      background: #173d9d;
      border-color: #173d9d;
    }

    .button-secondary {
      color: var(--text);
      border-bottom: 1px solid var(--border);
    }

    .button-secondary:hover {
      color: var(--home-blue);
      border-color: var(--home-blue);
    }

    .hero-aside {
      padding: 8px 0 2px 24px;
      border-left: 2px solid var(--home-blue);
    }

    .aside-label {
      margin-bottom: 14px;
    }

    .hero-aside ul {
      display: grid;
      gap: 10px;
      padding: 0;
      color: var(--text);
      font-size: 0.94rem;
      font-weight: 600;
      list-style: none;
    }

    .aside-note {
      margin-top: 21px;
      color: var(--text-muted);
      font-size: 0.82rem;
      line-height: 1.75;
    }

    .projects-section,
    .notes-section {
      padding: 66px 0 12px;
    }

    .section-heading {
      display: flex;
      align-items: end;
      justify-content: space-between;
      gap: 24px;
      margin-bottom: 26px;
    }

    .section-kicker {
      margin-bottom: 9px;
      color: var(--home-blue);
      font-size: 0.72rem;
    }

    .section-kicker span {
      margin-right: 8px;
      color: var(--text-muted);
      font-family: var(--font-mono);
      font-weight: 500;
    }

    .section-heading h2 {
      color: var(--text);
      font-size: clamp(1.55rem, 3.2vw, 2.15rem);
      font-weight: 750;
      letter-spacing: -0.04em;
      line-height: 1.25;
    }

    .section-link {
      display: inline-flex;
      flex: 0 0 auto;
      align-items: center;
      gap: 8px;
      padding-bottom: 3px;
      color: var(--text);
      border-bottom: 1px solid var(--border);
      font-size: 0.88rem;
      font-weight: 600;
      text-decoration: none;
      transition: color 160ms ease, border-color 160ms ease;
    }

    .section-link:hover {
      color: var(--home-blue);
      border-color: var(--home-blue);
    }

    .featured-project {
      display: grid;
      grid-template-columns: minmax(0, 1.2fr) minmax(300px, 0.8fr);
      min-height: 350px;
      overflow: hidden;
      background: var(--card-bg);
      border: 1px solid var(--border);
    }

    .featured-visual {
      position: relative;
      display: block;
      min-height: 320px;
      overflow: hidden;
      background: var(--bg-secondary);
    }

    .featured-visual img,
    .project-cover img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 220ms ease;
    }

    .featured-visual:hover img,
    .project-cover:hover img {
      transform: scale(1.025);
    }

    .visual-label {
      position: absolute;
      top: 16px;
      left: 16px;
      padding: 6px 10px;
      color: #fff;
      background: var(--home-blue);
      font-size: 0.75rem;
      font-weight: 700;
      letter-spacing: 0.03em;
    }

    .featured-copy {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      padding: clamp(24px, 3.6vw, 42px);
    }

    .project-overline {
      margin-bottom: 14px;
      color: var(--home-blue);
    }

    .featured-copy h3 {
      color: var(--text);
      font-size: clamp(1.55rem, 2.6vw, 2.2rem);
      font-weight: 750;
      letter-spacing: -0.045em;
      line-height: 1.25;
    }

    .featured-copy h3 a,
    .project-card h3 a {
      color: inherit;
      text-decoration: none;
    }

    .featured-copy h3 a:hover,
    .project-card h3 a:hover {
      color: var(--home-blue);
    }

    .featured-description,
    .project-card-copy > p {
      color: var(--text-muted);
      font-size: 0.9rem;
      line-height: 1.75;
    }

    .featured-description {
      display: -webkit-box;
      overflow: hidden;
      margin-top: 14px;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 4;
    }

    .tag-list {
      display: flex;
      flex-wrap: wrap;
      gap: 7px;
      margin: 18px 0 0;
      padding: 0;
      list-style: none;
    }

    .tag-list li {
      padding: 4px 8px;
      color: var(--text-muted);
      border: 1px solid var(--border);
      font-size: 0.72rem;
      line-height: 1.4;
    }

    .project-action {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      margin-top: auto;
      padding-top: 23px;
      color: var(--home-blue);
      font-size: 0.88rem;
      font-weight: 700;
      text-decoration: none;
    }

    .project-action:hover {
      color: #173d9d;
    }

    .project-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 18px;
      margin-top: 20px;
    }

    .project-card {
      min-width: 0;
      overflow: hidden;
      background: var(--card-bg);
      border: 1px solid var(--border);
    }

    .project-cover {
      display: block;
      aspect-ratio: 16 / 10;
      overflow: hidden;
      background: var(--bg-secondary);
    }

    .project-card-copy {
      display: flex;
      min-height: 190px;
      flex-direction: column;
      align-items: flex-start;
      padding: 19px;
    }

    .project-card h3 {
      color: var(--text);
      font-size: 1.08rem;
      font-weight: 700;
      letter-spacing: -0.02em;
      line-height: 1.4;
    }

    .project-card-copy > p {
      display: -webkit-box;
      overflow: hidden;
      margin-top: 9px;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 3;
    }

    .project-card .tag-list {
      margin-top: auto;
      padding-top: 15px;
    }

    .notes-section {
      margin-top: 46px;
      padding-top: 58px;
      border-top: 1px solid var(--border);
    }

    .notes-heading {
      margin-bottom: 18px;
    }

    .notes-list {
      margin: 0;
      padding: 0;
      border-top: 1px solid var(--border);
      list-style: none;
    }

    .notes-list li {
      border-bottom: 1px solid var(--border);
    }

    .note-entry {
      display: grid;
      grid-template-columns: minmax(150px, 0.34fr) minmax(0, 1fr) 20px;
      align-items: start;
      gap: 26px;
      padding: 22px 4px;
      color: inherit;
      text-decoration: none;
      transition: color 160ms ease;
    }

    .note-entry:hover h3,
    .note-entry:hover .note-arrow {
      color: var(--home-blue);
    }

    .note-meta {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 8px;
      color: var(--text-muted);
      font-family: var(--font-mono);
      font-size: 0.76rem;
      line-height: 1.5;
    }

    .note-topic {
      color: var(--home-blue);
      font-family: var(--font-sans);
      font-size: 0.75rem;
      font-weight: 650;
    }

    .note-copy h3 {
      color: var(--text);
      font-size: 1.03rem;
      font-weight: 700;
      letter-spacing: -0.02em;
      line-height: 1.55;
      transition: color 160ms ease;
    }

    .note-copy p {
      display: -webkit-box;
      overflow: hidden;
      margin-top: 6px;
      color: var(--text-muted);
      font-size: 0.86rem;
      line-height: 1.7;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 2;
    }

    .note-arrow {
      padding-top: 2px;
      color: var(--text-muted);
      transition: color 160ms ease;
    }

    @media (max-width: 820px) {
      .home-page .hero {
        grid-template-columns: minmax(0, 1fr);
        gap: 34px;
        padding: 62px 0 54px;
      }

      .hero-aside {
        display: grid;
        grid-template-columns: auto 1fr;
        align-items: start;
        gap: 8px 20px;
      }

      .aside-label {
        grid-row: span 2;
        margin: 1px 0 0;
      }

      .hero-aside ul {
        display: flex;
        flex-wrap: wrap;
        gap: 8px 18px;
      }

      .aside-note {
        margin-top: 4px;
      }

      .featured-project {
        grid-template-columns: minmax(0, 1fr) minmax(260px, 0.88fr);
      }

      .project-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      .project-card:last-child:nth-child(odd) {
        grid-column: 1 / -1;
      }
    }

    @media (max-width: 600px) {
      .home-page .hero {
        gap: 30px;
        padding: 48px 0 40px;
      }

      .eyebrow {
        margin-bottom: 17px;
      }

      .hero h1 {
        font-size: clamp(2.15rem, 9.5vw, 2.65rem);
        letter-spacing: -0.06em;
        line-height: 1.27;
      }

      .hero-intro {
        margin-top: 18px;
        font-size: 0.98rem;
      }

      .hero-actions {
        gap: 10px 16px;
        margin-top: 23px;
      }

      .button {
        min-height: 44px;
        font-size: 0.88rem;
      }

      .hero-aside {
        grid-template-columns: 1fr;
        gap: 8px;
        padding-left: 16px;
      }

      .aside-label {
        grid-row: auto;
      }

      .hero-aside ul {
        gap: 7px 14px;
        font-size: 0.82rem;
      }

      .aside-note {
        margin-top: 4px;
        font-size: 0.78rem;
      }

      .projects-section,
      .notes-section {
        padding-top: 48px;
      }

      .section-heading {
        align-items: flex-start;
        gap: 16px;
        margin-bottom: 20px;
      }

      .section-link {
        margin-top: 27px;
        font-size: 0.78rem;
        white-space: nowrap;
      }

      .featured-project {
        grid-template-columns: minmax(0, 1fr);
      }

      .featured-visual {
        min-height: 0;
        aspect-ratio: 16 / 10;
      }

      .featured-copy {
        padding: 23px 20px 24px;
      }

      .featured-description {
        -webkit-line-clamp: 5;
      }

      .project-grid {
        grid-template-columns: minmax(0, 1fr);
        gap: 14px;
      }

      .project-card:last-child:nth-child(odd) {
        grid-column: auto;
      }

      .project-card-copy {
        min-height: 0;
      }

      .project-card .tag-list {
        margin-top: 13px;
      }

      .notes-section {
        margin-top: 34px;
        padding-top: 42px;
      }

      .note-entry {
        grid-template-columns: minmax(0, 1fr) 18px;
        gap: 10px 16px;
        padding: 18px 2px;
      }

      .note-meta {
        grid-column: 1;
        flex-direction: row;
        flex-wrap: wrap;
        gap: 4px 12px;
        font-size: 0.72rem;
      }

      .note-copy {
        grid-column: 1;
      }

      .note-arrow {
        grid-column: 2;
        grid-row: 1 / span 2;
        justify-self: end;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .home-page *,
      .home-page *::before,
      .home-page *::after {
        scroll-behavior: auto !important;
        transition-duration: 0.01ms !important;
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
      }
    }
  </style>
</BaseLayout>
