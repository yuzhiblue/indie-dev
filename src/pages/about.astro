---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

import { dedupeProjects } from '../lib/projects-i18n';
import { personSchema } from '../lib/seo';

const projects = dedupeProjects(await getCollection('projects', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const timeline = [
  {
    year: '2026',
    title: '基础设施三件套成型',
    desc: '授权码系统、发卡商城、支付对接层全部迁移到 Cloudflare 免费套餐，软件销售流水线从此零平台抽成、零月费，数据完全自持。',
  },
  {
    year: '2026',
    title: '直播贴片水印工具上线',
    desc: '面向直播主的在线水印 SaaS：OBS 浏览器源即插即用，动态取证变量与 21 种行为特效，支持中英日三语。',
  },
  {
    year: '2026',
    title: 'MoonBit 开源库系列',
    desc: '为 MoonBit 生态连续开源 moon-diff（文本 diff/patch 库）、moon-watermark（图像水印库）与 moon-qdrant（向量数据库客户端），从算法层补齐生态基础件。',
  },
  {
    year: '2025.07',
    title: 'OBStimer 发布',
    desc: 'OBS Studio 定时脚本插件上线。直接调用 OBS Studio API 控制推流与录制按钮，不依赖窗口置顶，稳定性更高，一套脚本覆盖所有支持推流码的平台。',
  },
  {
    year: '2025.05',
    title: 'Wxtimer 发布',
    desc: '视频号版本上线，支持读秒验证自动下播、直播带货、循环直播与多组定时，适配微信视频号的开播流程。',
  },
  {
    year: '2025.04',
    title: 'Doutimer 插件化重构',
    desc: '把最早的单文件架构拆成调度框架、平台面板、自动化实现三层解耦，新增平台只需实现面板与自动化层，不再改动调度核心。',
  },
  {
    year: '2025.03',
    title: 'Kwaitimer 独立',
    desc: '把快手能力从双平台版本中拆出，做成独立的快手单平台版本，降低不需要抖音的用户的使用与理解成本。',
  },
  {
    year: '2024.07',
    title: 'Doutimer 上线',
    desc: '第一款产品。通过调用 Windows 底层 API 实现自动化点击，支持抖音、快手双平台的定时开播与下播。',
  },
];

const stack = [
  { label: '语言与框架', items: ['Python', 'PySide6 / Qt', 'MoonBit', 'TypeScript / Hono'] },
  { label: '桌面自动化', items: ['Windows API', 'UI 自动化'] },
  { label: '服务端', items: ['Cloudflare Workers', 'D1 / KV'] },
  { label: '站点', items: ['Astro', 'MDX'] },
];
---

<BaseLayout
  title="关于我"
  description="关于 yuzhiblue（7TEC）：一名来自中国的独立开发者，从 Windows 直播自动化工具起步，如今同时维护 MoonBit 开源库、在线直播贴片水印工具，以及授权码、发卡、支付对接等自建基础设施。这里记录我的产品、开源项目与独立开发的思考。"
  schema={personSchema()}
>
  <section class="about-hero">
    <h1>关于我</h1>
    <p class="lead">
      我是 yuzhiblue，一名独立开发者。起点是 Windows 桌面自动化——为主播和直播运营
      做能替他们守着开播时间的工具；现在，我把这条"从做工具到卖工具"的路上
      沉淀出的每一环，都做成了产品或开源项目。
    </p>
  </section>

  <section class="block">
    <h2 class="section-title">我在做什么</h2>
    <p class="text">
      直播有一个很具体、也很折磨人的痛点：开播和下播的时间点必须准，但人不可能一直守在电脑前。
      我的工具通过调用 Windows 底层 API 直接操作直播伴侣与 OBS Studio，把定时任务稳定跑完——
      任务执行期间不要求窗口在最上层，可以最小化到后台照常运行。
    </p>
    <p class="text">
      我的做法是先把工具做出来自己用，再打磨成别人也能不看文档就上手的产品。
      比起「大而全」，我更在意「小而准」：一个每天帮你省下半小时、且不会在关键时刻掉链子的小工具，
      往往比庞大的系统更有生命力。
    </p>
    <p class="text">
      2026 年起，我的重心从单一产品扩展成三条线：<strong>商业工具</strong>（直播定时助手系列与在线直播贴片水印工具）、
      <strong>开源库</strong>（为 MoonBit 生态补上文本 diff、图像水印、向量数据库客户端这些基础件）、
      以及<strong>自建基础设施</strong>（授权码系统、发卡商城、支付对接层——把"卖软件"这条流水线的每一环都握在自己手里，运行成本趋近于零）。
    </p>
  </section>

  <section class="block">
    <h2 class="section-title">产品</h2>
    <ul class="product-list">
      {projects.map((project) => (
        <li class="product-item">
          <a class="product-link" href={`/projects/${project.id}/`}>
            <span class="product-name">{project.data.title}</span>
            <span class="product-desc">{project.data.description}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="block">
    <h2 class="section-title">经历</h2>
    <ul class="timeline">
      {timeline.map((item) => (
        <li class="timeline-item">
          <span class="timeline-year">{item.year}</span>
          <div class="timeline-content">
            <h3>{item.title}</h3>
            <p>{item.desc}</p>
          </div>
        </li>
      ))}
    </ul>
  </section>

  <section class="block">
    <h2 class="section-title">技术栈</h2>
    <div class="stack-grid">
      {stack.map((group) => (
        <div class="stack-group">
          <span class="stack-label">{group.label}</span>
          <div class="stack-items">
            {group.items.map((item) => (<span class="stack-item">{item}</span>))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="block">
    <h2 class="section-title">更多</h2>
    <p class="text">
      想了解产品细节或最新动态，可以先看看
      <a href="/projects/">项目列表</a>；
      有问题或想聊聊，欢迎发邮件到
      <a href="mailto:630110598@qq.com">630110598@qq.com</a>，
      或在首页的「关注我」板块找到我。
    </p>
  </section>
</BaseLayout>

<style>
  .about-hero { margin-bottom: 48px; }
  .about-hero h1 {
    font-size: 2.4rem; font-weight: 800; letter-spacing: -0.03em; margin-bottom: 16px;
    background: linear-gradient(135deg, #fff 0%, #888 100%);
    -webkit-background-clip: text; -webkit-text-fill-color: transparent;
  }
  .lead { color: var(--text-muted); font-size: 1.1rem; max-width: 640px; line-height: 1.7; }
  .block { margin-bottom: 48px; }
  .section-title {
    font-size: 1.1rem; font-weight: 600; color: var(--text);
    margin-bottom: 20px; display: flex; align-items: center; gap: 12px;
  }
  .section-title::before {
    content: ''; width: 4px; height: 20px; background: var(--accent); border-radius: 2px;
  }
  .text { color: var(--text-muted); font-size: 0.95rem; line-height: 1.8; max-width: 680px; margin-bottom: 14px; }
  .text:last-child { margin-bottom: 0; }
  .text a { color: var(--accent); }

  .product-list { list-style: none; display: flex; flex-direction: column; gap: 12px; }
  .product-link {
    display: block; padding: 16px 18px; background: var(--card-bg);
    border: 1px solid var(--border); border-radius: 10px;
    transition: border-color 0.2s, transform 0.2s;
  }
  .product-link:hover { border-color: var(--accent); transform: translateY(-2px); }
  .product-name { display: block; font-size: 0.98rem; font-weight: 600; color: var(--text); margin-bottom: 6px; }
  .product-desc { display: block; font-size: 0.85rem; color: var(--text-muted); line-height: 1.6; }

  .timeline { list-style: none; display: flex; flex-direction: column; gap: 24px; }
  .timeline-item { display: flex; gap: 20px; align-items: flex-start; }
  .timeline-year {
    flex: 0 0 64px; color: var(--accent); font-weight: 600; font-size: 0.95rem;
    padding-top: 2px;
  }
  .timeline-content h3 { font-size: 1rem; font-weight: 600; margin-bottom: 6px; }
  .timeline-content p { color: var(--text-muted); font-size: 0.9rem; line-height: 1.6; }

  .stack-grid {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px;
  }
  .stack-group {
    background: var(--card-bg); border: 1px solid var(--border);
    border-radius: 10px; padding: 14px 16px;
  }
  .stack-label { display: block; font-size: 0.78rem; color: var(--text-muted); margin-bottom: 10px; }
  .stack-items { display: flex; flex-wrap: wrap; gap: 8px; }
  .stack-item {
    font-size: 0.78rem; padding: 4px 10px; border-radius: 20px;
    background: var(--bg-secondary); border: 1px solid var(--border); color: var(--text);
  }

  @media (max-width: 768px) {
    .about-hero h1 { font-size: 2rem; }
  }
  @media (max-width: 640px) {
    .about-hero h1 { font-size: 1.8rem; }
    .timeline-item { flex-direction: column; gap: 4px; }
  }
</style>
